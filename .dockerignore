# Start with an empty build context. Only the runtime allowlist below is re-included.
**

# Docker metadata, environment files, credentials, and local state stay excluded.
.git/
**/.env
**/.env.*
**/*credentials*
**/*secret*
**/*token*
**/*.pem
**/*.key

# The image needs only the official entry point and the two runtime packages.
!Dockerfile
!requirements.txt
!run.py
!agents/
!agents/**
!rca/
!rca/**
!libraries/
!libraries/trace_semantics/
!libraries/trace_semantics/src/
!libraries/trace_semantics/src/trace_semantics/
!libraries/trace_semantics/src/trace_semantics/**
!libraries/rca_domain/
!libraries/rca_domain/src/
!libraries/rca_domain/src/rca_domain/
!libraries/rca_domain/src/rca_domain/**
!scripts/
!scripts/demo_discovery.py
!scripts/demo_investigation.py
!scripts/validate_discovery.py
!scripts/discover.py

# Re-apply secret exclusions after the runtime directories are re-included.
**/.env
**/.env.*
**/*credentials*
**/*secret*
**/*token*
**/*.pem
**/*.key
**/__pycache__/
**/*.py[cod]
